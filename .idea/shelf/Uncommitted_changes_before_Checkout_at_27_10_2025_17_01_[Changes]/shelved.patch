<+><!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>IT WEBSITE</title>\r\n    <link rel=\"stylesheet\" href=\"/src/assets/styles/style.css\">\r\n</head>\r\n<body>\r\n<div class=\"header-wrapper\">\r\n    <div class=\"white-header\">\r\n        <div class=\"logo\">IT WEBSITE</div>\r\n        <nav>\r\n            <a href=\"#\">Services</a>\r\n            <a href=\"#\">Media</a>\r\n            <a href=\"#\">Cases</a>\r\n            <a href=\"#\">FAQ</a>\r\n            <a href=\"#\">Contacts</a>\r\n        </nav>\r\n        <div class=\"header-contacts\">\r\n                <span class=\"header-phone\">\r\n                    <img src=\"/src/assets/icons/IconPhone.svg\" alt=\"\" class=\"icon\">\r\n                    +7 (111) 111 11 11\r\n                </span>\r\n            <span class=\"header-phone\">\r\n                    +7 (111) 111 11 11\r\n                </span>\r\n            <span class=\"header-email\">\r\n                    <img src=\"/src/assets/icons/IconEmail.svg\" alt=\"\" class=\"icon\">\r\n                    itcompany@mail.com\r\n                </span>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"container\">\r\n    <div class=\"main-section\">\r\n        <div class=\"main-content\">\r\n            <h1>\r\n                Development of <span class=\"blue\">mobile applications</span> and <span class=\"blue\">web services</span> of any complexity\r\n            </h1>\r\n            <p>\r\n                We create mobile applications for iOS, Android that transfer your business to mobile applications of your customers' devices\r\n            </p>\r\n            <form class=\"callback-form\">\r\n                <label class=\"callback-label\">Leave your contacts and we will call you back within 30 minutes</label>\r\n                <div class=\"callback-row\">\r\n                    <div class=\"callback-field